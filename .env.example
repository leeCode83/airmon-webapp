# AirMon — Supabase credentials
# Get both values from: Supabase Dashboard > Project Settings > API
# (the same URL and key the ESP32 firmware already posts to — see monitor_udara_supabase.ino)
#
# NEXT_PUBLIC_ = readable in the browser. That is safe here: RLS on the `log`
# table allows the publishable/anon key to SELECT only, never to write.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
